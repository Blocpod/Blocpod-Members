# Production refuses to start without PostgreSQL. Use your provider's TLS connection URL.
DATABASE_URL=
APP_URL=http://127.0.0.1:5173
PORT=3001
PGLITE_PATH=.data/postgres
# Explicit local-only demo; ignored in production.
DEMO_MODE=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_OPERATOR_MONTHLY=
STRIPE_PRICE_OPERATOR_ANNUAL=
STRIPE_PRICE_BUILDER_MONTHLY=
STRIPE_PRICE_BUILDER_ANNUAL=
STRIPE_PRICE_FOUNDER_MONTHLY=
STRIPE_PRICE_FOUNDER_ANNUAL=
RESEND_API_KEY=
EMAIL_FROM=Blocpod <members@example.com>
# Select a model available to your account. No provider work is simulated.
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
# At least 32 random characters, required for production job dispatch.
JOBS_SECRET=
