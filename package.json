{
  "name": "blocpod-operating-network",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "build": "tsc --noEmit && vite build && tsx scripts/prerender.tsx",
    "start": "tsx server/local.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "test": "tsx --test tests/*.test.ts",
    "check": "tsc --noEmit",
    "test:e2e": "playwright test",
    "db:seed:core": "tsx scripts/seed.ts --core",
    "admin:create": "tsx scripts/create-admin.ts",
    "test:built": "tsx scripts/smoke-built.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.3.14",
    "@hono/node-server": "^1.19.9",
    "hono": "^4.10.0",
    "lucide-react": "^0.468.0",
    "pg": "^8.16.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.9.3",
    "stripe": "^22.6.0",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.1",
    "@types/node": "^24.5.2",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.3",
    "tsx": "^4.20.6",
    "typescript": "^5.9.2",
    "vite": "^7.1.7"
  },
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24"
  }
}
